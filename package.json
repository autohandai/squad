{
  "name": "autohandswe",
  "version": "0.1.5",
  "private": true,
  "description": "A native workspace for human and agent teams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autohandai/squad.git"
  },
  "bugs": {
    "url": "https://github.com/autohandai/squad/issues"
  },
  "homepage": "https://github.com/autohandai/squad#readme",
  "type": "module",
  "autohand": {
    "cliVersion": "0.9.7",
    "cliRepository": "autohandai/code-cli"
  },
  "scripts": {
    "dev": "node server.mjs --dev --host 127.0.0.1 --port 19821",
    "build": "node scripts/check-jsx-imports.mjs && vite build",
    "preview": "node server.mjs --host 127.0.0.1 --port 19821",
    "cli:fetch": "node scripts/fetch-autohand-cli.mjs",
    "cli:fetch:all": "node scripts/fetch-autohand-cli.mjs --all",
    "check:sdk": "node scripts/check-agent-sdk.mjs",
    "check:harness": "node scripts/check-harness-adapters.mjs",
    "check:otel": "node scripts/check-otel-logs.mjs",
    "check:sessions": "node scripts/check-sdk-sessions.mjs",
    "check:recruiting": "node scripts/check-squad-recruiting.mjs",
    "check:jsx": "node scripts/check-jsx-imports.mjs",
    "check:members-presence": "node scripts/check-members-presence.mjs",
    "check:server": "node --check server.mjs",
    "check:onboarding": "node scripts/verify-onboarding-flow.mjs",
    "check:onboarding:browser": "node scripts/verify-onboarding-browser.mjs",
    "check:channels:browser": "node scripts/verify-channel-browser.mjs",
    "check:web": "bun run build",
    "check:runtime": "cd daemon && cargo fmt -- --check && cargo test -j1 -- --test-threads=1 && cargo build --bins -j1",
    "check:release": "node scripts/check-release-workflows.mjs",
    "ci": "bun run cli:fetch && bun run check:sdk && bun run check:harness && bun run check:otel && bun run check:sessions && bun run check:recruiting && bun run check:jsx && bun run check:members-presence && bun run check:server && bun run check:release && bun run check:web && bun run check:runtime",
    "release:version": "node scripts/resolve-squad-version.mjs",
    "release:package": "node scripts/package-squad-release.mjs",
    "release:portable": "node scripts/package-squad-portable.mjs",
    "release:installers": "node scripts/package-squad-installers.mjs",
    "release:desktop": "node scripts/package-desktop-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:merge-manifests": "node scripts/merge-release-manifests.mjs",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@autohandai/agent-sdk": "1.0.5",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "0.25.12",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@crabnebula/packager": "0.8.1",
    "@tauri-apps/cli": "^2"
  }
}
